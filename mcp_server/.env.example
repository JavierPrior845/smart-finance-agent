# URL base de la API REST de Smart Finance (por defecto en Docker local)
SMART_FINANCE_API_BASE_URL=http://localhost:8000/api/v1

# Credenciales para autenticación automática del Servidor MCP
SMART_FINANCE_EMAIL=usuario@ejemplo.com
SMART_FINANCE_PASSWORD=tu_contraseña_secreta

# Opcional: Token JWT estático pregenerado (si se proporciona, se usará en lugar de login)
SMART_FINANCE_ACCESS_TOKEN=
