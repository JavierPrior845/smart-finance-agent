# System Environment (Development)
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# PostgreSQL Database (Dev Isolated)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smart_finance_dev
POSTGRES_DEV_PORT=5433

# Redis Task Queue (Dev Isolated)
REDIS_DEV_PORT=6380

# API & Frontend Ports (Dev Isolated)
API_DEV_PORT=8001
FRONTEND_DEV_PORT=3001

# Telegram Bot Security & Auth
TELEGRAM_BOT_TOKEN=your_dev_telegram_bot_token
TELEGRAM_ALLOWED_USER_IDS=123456789

# AI Providers
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OLLAMA_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen2.5-coder:1.5b

# App Settings
DEFAULT_CURRENCY=EUR
SECRET_KEY=dev-super-secret-key
